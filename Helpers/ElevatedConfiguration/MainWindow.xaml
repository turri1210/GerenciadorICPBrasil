<Window x:Class="ConfigAuditoria.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:ConfigAuditoria.Converters"
        xmlns:controls="clr-namespace:ConfigAuditoria.Controls"
        xmlns:models="clr-namespace:ConfigAuditoria.Models"
        mc:Ignorable="d"
        Title="ConfigAuditoria"
        Height="780"
        Width="1180"
        MinHeight="620"
        MinWidth="880"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/img/RedeIcpBrasil.ico">
    <Window.Resources>
        <conv:StatusToBrushConverter x:Key="StatusToBrushConverter"/>
        <conv:StatusToVisibilityConverter x:Key="StatusToVisibilityConverter"/>
        <conv:StatusToBoolConverter x:Key="StatusToBoolConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid Background="#F2F4F7">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="White"
                Margin="20"
                Padding="24"
                CornerRadius="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/img/RedeIcpBrasil.png"
                           Width="64"
                           Height="64"
                           Stretch="Uniform"
                           Margin="0,0,12,0"/>
                    <StackPanel Orientation="Vertical"
                                VerticalAlignment="Center"
                                MaxWidth="240">
                        <TextBlock Text="Configurações de segurança"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#1F2937"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="Revise e aplique as configurações necessárias para manter a estação protegida."
                                   Margin="0,4,0,0"
                                   Foreground="#4B5563"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="1"
                        Margin="0,24,0,0"
                        Background="#0F172A"
                        CornerRadius="16"
                        Padding="20">
                    <StackPanel>
                        <TextBlock Text="Resumo do dispositivo"
                                   Foreground="#E0E7FF"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Margin="0,0,12,0">
                                <TextBlock Text="Hostname"
                                           Foreground="#CBD5F5"
                                           FontSize="12"/>
                                <TextBlock Text="{Binding HostName}"
                                           Foreground="White"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Margin="12,0,0,0">
                                <TextBlock Text="Data e hora"
                                           Foreground="#CBD5F5"
                                           FontSize="12"/>
                                <TextBlock Text="{Binding CurrentDateDisplay}"
                                           Foreground="#F9FAFB"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding CurrentTimeDisplay}"
                                           Foreground="#E5E7EB"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="#1E293B"
                                CornerRadius="12"
                                Padding="14"
                                Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Enderecos MAC"
                                           Foreground="#A5B4FC"
                                           FontSize="12"/>
                                <TextBlock Text="{Binding MacAddressDisplay}"
                                           Margin="0,6,0,0"
                                           Foreground="#F9FAFB"
                                           TextWrapping="Wrap"
                                           FontSize="14"
                                           MaxHeight="160"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2"
                        Background="Transparent"/>

                <StackPanel Grid.Row="3"
                            Margin="0,24,0,0">
                    <Button Content="Verificar configurações"
                            Height="48"
                            Margin="0,0,0,12"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Stretch"
                            Command="{Binding RefreshCommand}"/>
                    <Button Content="Aplicar configurações"
                            Height="48"
                            Margin="0,0,0,12"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Stretch"
                            Command="{Binding ApplyAllCommand}"/>
                    <Button Content="Salvar evidências"
                            Height="48"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Stretch"
                            Click="OnSaveEvidenceClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1"
                      Margin="0,20,20,20"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:AdaptiveGridPanel MinColumnWidth="240"
                                                    MinColumns="4"
                                                    MaxColumns="4"
                                                    ColumnSpacing="16"
                                                    RowSpacing="16"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.Resources>
                    <Style TargetType="Button" x:Key="CategoryButtonStyle">
                        <Setter Property="MinHeight" Value="120"/>
                        <Setter Property="Padding" Value="16"/>
                        <Setter Property="Background" Value="#F9FAFB"/>
                        <Setter Property="BorderBrush" Value="#D1D5DB"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                          Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.65"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EEF2FF"/>
                                <Setter Property="BorderBrush" Value="#6366F1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#C7D2FE"/>
                                <Setter Property="BorderBrush" Value="#4F46E5"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>

                    <DataTemplate DataType="{x:Type models:ConfigurationCategory}">
                        <Button Style="{StaticResource CategoryButtonStyle}"
                                Command="{Binding DataContext.RemediateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding IsInteractiveRemediationAvailable}"
                                ToolTipService.ShowDuration="20000">
                            <Button.ToolTip>
                                <ToolTip MaxWidth="360">
                                    <StackPanel MaxWidth="340">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="Bold"
                                                   TextWrapping="Wrap"
                                                   Foreground="#111827"/>
                                        <TextBlock Text="{Binding StatusMessage}"
                                                   Margin="0,6,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="#1F2937"/>
                                    </StackPanel>
                                </ToolTip>
                            </Button.ToolTip>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Width="26"
                                      Height="26"
                                      VerticalAlignment="Center">
                                    <Ellipse Fill="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                             Stroke="#D1D5DB"
                                             StrokeThickness="1">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>

                                    <Path Stroke="#4F46E5"
                                          StrokeThickness="2"
                                          StrokeDashArray="1 3"
                                          StrokeDashCap="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="M13,2 A11,11 0 1 1 12.99,2"
                                          RenderTransformOrigin="0.5,0.5"
                                          Visibility="Collapsed">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="0"/>
                                        </Path.RenderTransform>
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard RepeatBehavior="Forever">
                                                                    <DoubleAnimation Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                                                                      From="0"
                                                                                      To="360"
                                                                                      Duration="0:0:1.2"
                                                                                      FillBehavior="Stop"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Grid>

                                <Grid Grid.Column="1"
                                      Margin="12,0"
                                      VerticalAlignment="Stretch">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="{Binding DisplayName}"
                                               FontWeight="SemiBold"
                                               Foreground="#1F2937"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding StatusMessage}"
                                               Foreground="#6B7280"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,6,0,0"
                                               MaxHeight="48"/>
                                </Grid>

                                <Grid Grid.Column="2"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Right">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsInteractiveRemediationAvailable}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsInteractiveRemediationAvailable}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Path Stroke="#10B981"
                                          StrokeThickness="2"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="M1,8 L6,13 L15,4"/>
                                </Grid>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.Resources>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
