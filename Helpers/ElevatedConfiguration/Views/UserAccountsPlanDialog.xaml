<Window x:Class="ConfigAuditoria.Views.UserAccountsPlanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuração de Contas de Usuário"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Width="860"
        Height="640"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="False">
    <Border BorderBrush="#D1D5DB"
            BorderThickness="1"
            Padding="16"
            Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,12">
                <TextBlock Text="Contas de usuário locais"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <TextBlock Text="Apenas 1 conta pode ter perfil Administrador. As demais devem ficar com perfil Usuário."
                           TextWrapping="Wrap"
                           Margin="0,0,0,2"/>
                <TextBlock Text="Configuração mínima: 1 Administrador e 1 Usuário."
                           TextWrapping="Wrap"/>
            </StackPanel>

            <DataGrid x:Name="AccountsDataGrid"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="False"
                      HeadersVisibility="Column"
                      Margin="0,0,0,12"
                      ItemsSource="{Binding Accounts}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Usuário"
                                        Binding="{Binding UserName}"
                                        IsReadOnly="True"
                                        Width="2*"/>
                    <DataGridTextColumn Header="Senha"
                                        Binding="{Binding PasswordMask}"
                                        IsReadOnly="True"
                                        Width="*"/>
                    <DataGridTemplateColumn Header="Perfil"
                                            Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.ProfileOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding Profile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          MinWidth="140"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="2"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Padding="10"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.ColumnSpan="2"
                               Text="Adicionar novo usuário"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <TextBox x:Name="UserNameTextBox"
                             Grid.Row="1"
                             Grid.Column="0"
                             Margin="0,0,8,8"
                             ToolTip="Nome de usuário"/>
                    <ComboBox x:Name="ProfileComboBox"
                              Grid.Row="1"
                              Grid.Column="1"
                              Margin="0,0,0,8"
                              ItemsSource="{Binding ProfileOptions}"/>
                    <PasswordBox x:Name="PasswordBox"
                                 Grid.Row="2"
                                 Grid.Column="0"
                                 Margin="0,0,8,8"
                                 ToolTip="Senha"/>
                    <PasswordBox x:Name="ConfirmPasswordBox"
                                 Grid.Row="2"
                                 Grid.Column="1"
                                 Margin="0,0,0,8"
                                 ToolTip="Confirmar senha"/>

                    <Button Grid.Row="3"
                              Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Height="32"
                            HorizontalAlignment="Stretch"
                            Content="Criar"
                            Click="OnAddUserClick"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="3">
                <TextBlock x:Name="FeedbackTextBlock"
                           Foreground="#B91C1C"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Aplicar"
                            Width="100"
                            Margin="0,0,8,0"
                            IsDefault="True"
                            Click="OnApplyClick"/>
                    <Button Content="Cancelar"
                            Width="100"
                            IsCancel="True"
                            Click="OnCancelClick"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
